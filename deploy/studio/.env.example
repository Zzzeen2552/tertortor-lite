# VPS: copy to /opt/tertortor/.env (chmod 600). Never commit the real one.
# node tools/relay.mjs hash '<password>'   (run on the laptop, paste the output; quote it in shells: it contains $)
STUDIO_PASSWORD_HASH=
# the same value goes into the laptop's .env as RELAY_WORKER_TOKEN, plus RELAY_URL=https://studio.<domain>
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_WORKER_TOKEN=
CACHE_MAX_MB=3000
MAX_UPLOAD_MB=95
# Web Push: node tools/relay.mjs vapid  (adds VAPID_PUBLIC / VAPID_PRIVATE / VAPID_SUBJECT here)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=https://tertortor.redactor.my.id
